#!/usr/bin/env bash
# ============================================================================
#  Launch the SCPI_Control GUI from the shared drive -- via a LOCAL CACHE.
#  Any user on this machine (e.g. robotincubator) can run it:
#
#      bash /mnt/shareDrive/_software/launch_gui.sh
#
#  Why the cache: cold CIFS imports cost ~70 s (pylibs is ~700 small files
#  read over SMB on the first launch after login/boot -- GitHub issue #41).
#  The app + deps are mirrored to a per-user local cache and Python runs
#  from local disk. Only ONE share file (version.py) is read per launch to
#  decide whether to re-sync; update_software.sh stamps a fresh git hash on
#  every deploy, so a stamp match means the cache is current.
#
#  The working directory stays on the SHARE app dir so the relative
#  presets/ path keeps presets shared between users.
# ============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP="$HERE/SCPI_Control"
LIBS="$HERE/pylibs"
CACHE="${SCPI_CACHE:-$HOME/.cache/scpi_control}"

# System interpreter (on local disk, so it can be executed -- a venv python
# on the CIFS share cannot). Override with SCPI_PYTHON=/path/to/python.
PY="${SCPI_PYTHON:-/usr/bin/python3.11}"
command -v "$PY" >/dev/null 2>&1 || PY=python3.11

if [ ! -f "$APP/gui.py" ]; then
  echo "error: $APP/gui.py not found -- run update_software.sh first." >&2
  exit 1
fi

# --- refresh the local cache when the share's version stamp changed --------
stamp() { grep -m1 '^__version__' "$1" 2>/dev/null || echo none; }
share_stamp="$(stamp "$APP/version.py")"
cache_stamp="$(stamp "$CACHE/SCPI_Control/version.py")"

RUN_APP="$CACHE/SCPI_Control"
RUN_LIBS="$CACHE/pylibs"
if [ "$share_stamp" != "$cache_stamp" ] || [ ! -f "$RUN_APP/gui.py" ]; then
  echo "Updating local cache $CACHE ($share_stamp)..."
  # This copy takes ~25 s after a deploy and happens BEFORE python starts,
  # so the app's own splash cannot cover it. Show a small Tk "updating"
  # window for the duration (system python3.11 + tkinter are always
  # present; no GTK/a11y bus needed, unlike zenity). notify-send is a
  # best-effort extra for headless/again-later cases.
  SPLASH_PID=""
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -f "$HERE/update_splash.py" ]; then
    "$PY" "$HERE/update_splash.py" >/dev/null 2>&1 &
    SPLASH_PID=$!
  fi
  notify-send -t 40000 "SCPI Control" \
    "New version found - updating this PC's local copy. The window will open in about half a minute." 2>/dev/null || true
  if ! mkdir -p "$CACHE" ||
     ! rsync -a --delete --exclude presets/ "$APP/" "$RUN_APP/" ||
     ! rsync -a --delete "$LIBS/" "$RUN_LIBS/"; then
    echo "warning: cache sync failed -- running directly from the share." >&2
    RUN_APP="$APP"; RUN_LIBS="$LIBS"
  fi
  [ -n "$SPLASH_PID" ] && kill "$SPLASH_PID" 2>/dev/null || true
fi

# cd into the SHARE app dir so gui.py's relative presets/ path resolves to
# the shared presets folder (presets stay shared between all users).
cd "$APP"

# --- run WITH a log, and never fail silently ------------------------------
# The desktop entry is Terminal=false and this script used to exec python
# with its output going nowhere, so a startup crash looked identical to
# "the splash vanished and nothing happened" -- unreportable and
# undiagnosable (bench report 2026-07-25). Keep the previous session's log
# so a crash survives the user immediately relaunching.
LOG="$CACHE/launch.log"
mkdir -p "$CACHE" 2>/dev/null || true
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.prev" 2>/dev/null || true
{
  echo "=== SCPI Control launch $(date -Is) ==="
  echo "user=$(id -un) host=$(hostname) display=${DISPLAY:-none}${WAYLAND_DISPLAY:+ wayland=$WAYLAND_DISPLAY}"
  echo "app=$RUN_APP libs=$RUN_LIBS python=$PY"
  echo "version: $share_stamp"
  echo
} >"$LOG" 2>/dev/null || true

set +e
env PYTHONPATH="$RUN_LIBS${PYTHONPATH:+:$PYTHONPATH}" "$PY" "$RUN_APP/gui.py" "$@" 2>&1 \
  | tee -a "$LOG"
rc=${PIPESTATUS[0]}
set -e

if [ "${rc:-0}" -ne 0 ]; then
  detail="$(tail -n 20 "$LOG" 2>/dev/null)"
  msg="SCPI Control exited with code $rc.

Log: $LOG

$detail"
  # zenity -> notify-send -> a plain Tk window (python3.11+tkinter are
  # always present here, unlike GTK/zenity on a bare session)
  zenity --error --width=760 --title "SCPI Control failed to start" \
         --text "$msg" 2>/dev/null \
    || notify-send -u critical "SCPI Control failed to start" \
         "exit $rc -- see $LOG" 2>/dev/null \
    || SCPI_ERRMSG="$msg" "$PY" -c '
import os, tkinter as tk
from tkinter import scrolledtext
r = tk.Tk(); r.title("SCPI Control failed to start")
t = scrolledtext.ScrolledText(r, width=100, height=24, font="TkFixedFont")
t.pack(fill="both", expand=True); t.insert("1.0", os.environ.get("SCPI_ERRMSG", ""))
t.configure(state="disabled")
tk.Button(r, text="Close", command=r.destroy).pack(pady=6)
r.mainloop()' 2>/dev/null \
    || true
fi
exit "${rc:-0}"
